# Переменные окружения AI-прокси FuelMaster.
# Скопируйте в /etc/fuelmaster-ai.env, права: chown root:fuelmaster-ai, chmod 640.

# Ключ AI-провайдера (OpenRouter). ЭТОТ ключ больше не попадает в APK.
AI_PROVIDER_KEY=sk-or-v1-ЗАМЕНИТЕ_НА_НОВЫЙ_ПОСЛЕ_РОТАЦИИ
AI_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AI_PROVIDER_MODEL=deepseek/deepseek-r1-0528:free
AI_PROVIDER_MAX_TOKENS=1700
AI_REQUEST_TIMEOUT=55

# Лимит на пользователя
AI_RATE_LIMIT_PER_HOUR=20
AI_MAX_PROMPT_CHARS=4000

# Проверка Firebase ID token
FIREBASE_PROJECT_ID=Ваш_project_id
FIREBASE_SERVICE_ACCOUNT=/etc/fuelmaster-ai-service-account.json
