# AI-прокси FuelMaster — вставка в существующий server-блок nginx
# (например, storyhero.ru или отдельный поддомен).
#
# Проверьте, что у сервера уже есть TLS (сертификат Let's Encrypt),
# иначе Firebase ID token уйдёт в открытом виде.

location /fuelmaster/ai/ {
    proxy_pass         http://127.0.0.1:8095/;
    proxy_http_version 1.1;

    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;

    # AI отвечает долго — не рвать соединение по таймауту
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;

    # Тело запроса — только промпт
    client_max_body_size 64k;
}
